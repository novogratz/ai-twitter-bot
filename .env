TWITTER_API_SECRET=sNOjzh94TgEWW93fpNw5jn2YCcJfYdcdySMkz7kt0NsQomDdcD
TWITTER_ACCESS_TOKEN=417508671-23xi6q42l1C5bewuI48OByQHdXXNNkQMxOGlZYPE
TWITTER_ACCESS_TOKEN_SECRET=P6SoDb8lozoT4FIQn6ii1TBEDIyYrhTeq3CtREliEJVTV
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAALix9AEAAAAAyvrDO%2BbxJdVK9vBUxK8S%2B5iuOsg%3DMwLJEAmRu32NN6eQ57zexnDVFA2UCFcLHLOTbJ8BraA8W57FGp

# No Anthropic API key needed — the bot uses a local AI CLI.

# Provider selection. Local Ollama only for content generation.
# Set LLM_ALLOW_REMOTE_FALLBACK=1 with LLM_FALLBACK_CLI=codex only if you
# explicitly want a cloud fallback again.
BOT_HANDLE=AIBossGPT
AI_CLI=ollama
# 2026-06-21 (operator: posts get ~0 likes). The rebrand churn reset the
# per-surface models to the DEAD 'opencode/big-pickle' default → posts/
# quotes were generated by a broken/fallback model. Pin them to Sonnet and
# force the profile surfaces onto the claude CLI (ollama stays the reply
# firehose default). These three + PROFILE_LLM_PROVIDER must never be blank.
NEWS_MODEL=claude-sonnet-4-6
HOTAKE_MODEL=claude-sonnet-4-6
QUOTE_MODEL=claude-sonnet-4-6
PROFILE_LLM_PROVIDER=claude
OLLAMA_MODEL=fredrezones55/qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive
# 2026-05-15: opencode CLI is invoked WITHOUT --model. opencode uses
# its own local default (configured to qwen via ollama). big-pickle was
# timing out at 300s on every reply — 0 posts in 3.5h. Letting opencode
# pick its own model = ~50s end-to-end for a reply. Smoke tested.
# 600s ceiling so qwen3.6:35b-a3b never gets killed mid-generation on
# the big ~25k-char news/reply prompts. User mandate 2026-05-15: "I want
# it to be able to complete the news or messages all the time".
LLM_TIMEOUT_SECONDS=600

# 2026-06-02: news RE-ENABLED. It had been hard-disabled at 0 (no Décode/news
# posts at all), which is why volume was so low. The 20-min safe_run_bot_cycle
# now produces French news again, capped by MAX_NEWS_PER_DAY + the originals
# chokepoint. Content is French; replies match the parent's language.
MAX_NEWS_PER_DAY=10
NEWS_POSTS_PER_CYCLE=1
NEWS_POST_SPACING_SECONDS=14400
MAX_HOTAKES_PER_DAY=20
MAX_BREAKOUTS_PER_DAY=2
MAX_SPICY_PER_DAY=1
MAX_QUOTES_PER_DAY=150
MAX_RETWEETS_PER_DAY=6000
RETWEETS_PER_CYCLE=150
MAX_REPLIES_PER_CYCLE=250
DIRECT_REPLY_MAX_PER_CYCLE=320
DIRECT_REPLY_MAX_EN_PER_CYCLE=320
DIRECT_REPLY_FEED_SCAN_LIMIT=120
DIRECT_REPLY_PROFILE_SCAN_LIMIT=25
FOLLOW_BLAST_PER_CYCLE=0
FOLLOW_BLAST_DAILY_CAP=0
LIKE_BOT_PER_CYCLE=600
LIKE_BOT_DAILY_CAP=18000
# 2026-05-16: 8 → 15. Followback is highest-conversion reciprocity move.
# 2026-05-23: vacation push. Follow back credible new followers fast.
FOLLOWBACK_CAP=300
# 2026-05-27: full EN pivot — same floor for all content.
RETWEET_MIN_LIKES=3
RETWEET_FR_MIN_LIKES=3
# Same-day hard cap (24h) — user 2026-05-16: "only tweets from the
# same day". Tightened from 48h. Belt-and-suspenders: escape hatches
# also removed from retweet_bot / quote_tweet_bot in the same commit.
RETWEET_MAX_AGE_HOURS=24
QUOTE_MAX_AGE_HOURS=24
FAVORITE_REPOST_MAX_AGE_MINUTES=720
FEED_REPOST_MIN_ENGAGEMENT=3
RETWEET_FEED_SEARCHES_PER_CYCLE=8
# 2026-06-02: 720→2880 (12h→48h). Reply to tweets up to 48h old (the hard
# ceiling — reply_bot + direct_reply also cap at 2880), which widens the
# candidate pool so the 700/day reply target is reachable.
DIRECT_REPLY_MAX_AGE_MINUTES=4320
CONTENT_LANG_PRIMARY=en
CLAUDE_FALLBACK_MODEL=claude-sonnet-4-6
CONTENT_SCOPE=ai_crypto_only
NEWS_CANDIDATES=8
ENABLE_AI_MAINTENANCE=1
ENABLE_AI_DISCOVERY=1
ENABLE_CODEX_OPERATOR=1

# (NEWS_POSTS_PER_CYCLE set above to 2 — the dotenv loader takes the first
# occurrence, so this duplicate is kept only for reference.)
NEWS_POSTS_PER_CYCLE=2

# Growth optimization settings
GROWTH_ENHANCEMENT=1
FOLLOW_BACK_RATIO=0.3
RETWEET_ENGAGEMENT_THRESHOLD=5
BOOST_ENGAGEMENT_POSTS=1

# Strict daily content filtering to prevent reposts of old content
RETWEET_FORCE_DAILY_ONLY=1

# 2026-06-18 AI Big Boss: FOLLOW ONLY BIG AI ACCOUNTS, nothing else.
# whitelist-only mode = only accounts in whitelist.json (tier1/tier2, all big
# AI) may be followed; MIN_FOLLOWERS_TO_FOLLOW=100000 is the extra "big" gate.
ENABLE_FOLLOW_BLAST=0
FOLLOW_WHITELIST_ONLY=1
FOLLOW_ENFORCE_RATIO=0

# 2026-06-04: more reposts — lower the repost score bar + fresh-popular discovery
RETWEET_MIN_SCORE=5
QUOTE_MIN_LIKES=50
# 2026-06-18 operator: "slightly less posts than before" — 8 -> 6.
MAX_ORIGINALS_PER_DAY=24
MIN_SECONDS_BETWEEN_POSTS=1800
POST_JITTER_SECONDS=600
MAX_VIRAL_STUNTS_PER_DAY=1
MAX_QUOTE_REPOSTS_PER_DAY=150
MAX_REPLIES_PER_DAY=20000
MIN_SECONDS_BETWEEN_REPLIES=5
REPLY_JITTER_SECONDS=5
MAX_FOLLOWS_PER_DAY=500
# Only follow BIG AI accounts (operator 2026-06-17). The follow chokepoint
# scrapes the target's follower count and skips anyone below this floor.
MIN_FOLLOWERS_TO_FOLLOW=100000
MAX_UNFOLLOWS_PER_DAY=3000
UNFOLLOW_CAP_PER_CYCLE=20
MIN_SECONDS_BETWEEN_QUOTES=120
QUOTE_JITTER_SECONDS=90
FEED_SWEEP_MAX_REPLIES_PER_CYCLE=9999
FEED_SWEEP_MAX_QUOTES_PER_CYCLE=9999
FEED_SWEEP_SCAN_LIMIT=150
MAX_SPACE_PROMO_PER_DAY=0
