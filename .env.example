# ──────────── Identity ────────────
BOT_HANDLE=TheAIShrink

# ──────────── AI provider ────────────
# ollama / codex / opencode / claude / gemini. Default uses local Ollama only.
# To opt into cloud fallback, set LLM_ALLOW_REMOTE_FALLBACK=1 and
# LLM_FALLBACK_CLI=codex.
AI_CLI=ollama
LLM_FALLBACK_CLI=
NEWS_MODEL=opencode/big-pickle
HOTAKE_MODEL=opencode/big-pickle
REPLY_MODEL=opencode/big-pickle
PRIORITY_REPLY_MODEL=opencode/big-pickle
QUOTE_MODEL=opencode/big-pickle
ROAST_MODEL=opencode/big-pickle
OLLAMA_MODEL=orcarouter/Qwen3.8-27B-Uncensored
# Tried only if OLLAMA_MODEL fails to load or returns unusable output.
OLLAMA_FALLBACK_MODELS=qwen3:8b

# ──────────── Daily caps — original content ────────────
MAX_NEWS_PER_DAY=6
MAX_HOTAKES_PER_DAY=6
MAX_BREAKOUTS_PER_DAY=4
MAX_SPICY_PER_DAY=4
ORIGINAL_CONTENT_ENGINE_ENABLED=1
ORIGINAL_CONTENT_CANDIDATES_PER_SLOT=20
ORIGINAL_CONTENT_TOP_CONCEPTS=8
MAIN_POST_MINIMUM_QUALITY_SCORE=75
MAIN_POST_MINIMUM_ORIGINALITY_SCORE=75
MAIN_POST_OPERATING_MODE=growth_automation
MAIN_POST_REQUIRE_HUMAN_APPROVAL=0
TARGET_HOME_IMPRESSIONS_90D=500000

# ──────────── Daily caps — reshare + engagement ────────────
MAX_QUOTES_PER_DAY=80
MAX_RETWEETS_PER_DAY=80
MAX_REPLIES_PER_CYCLE=10
DIRECT_REPLY_MAX_PER_CYCLE=12
DIRECT_REPLY_MAX_EN_PER_CYCLE=1
DIRECT_REPLY_FEED_SCAN_LIMIT=90
DIRECT_REPLY_PROFILE_SCAN_LIMIT=30

# ──────────── Per-cycle quotas ────────────
RETWEETS_PER_CYCLE=8
FOLLOW_BLAST_PER_CYCLE=30
FOLLOW_BLAST_DAILY_CAP=650
LIKE_BOT_PER_CYCLE=22
LIKE_BOT_DAILY_CAP=1800
RETWEET_MIN_LIKES=25
RETWEET_FR_MIN_LIKES=15
RETWEET_MAX_AGE_HOURS=18
RETWEET_FEED_SEARCHES_PER_CYCLE=10
FEED_REPOST_MIN_ENGAGEMENT=5
FAVORITE_REPOSTS_PER_CYCLE=3
FAVORITE_REPOST_MIN_ENGAGEMENT=3
FAVORITE_REPOST_MAX_AGE_MINUTES=2880
RETWEET_FEED_SEARCHES_PER_CYCLE=5
DIRECT_REPLY_MAX_AGE_MINUTES=1440
X_FEED_SEARCHES_PER_CYCLE=2
LIKE_TOP_TAB_PROBABILITY=0.55
QUOTE_MAX_AGE_HOURS=18

# ──────────── Rate limits ────────────
LLM_MIN_SECONDS_BETWEEN_CALLS=75
LLM_MAX_CALLS_PER_HOUR=32
NEWS_POSTS_PER_CYCLE=3
NEWS_POST_SPACING_SECONDS=120

# ──────────── Self-modification toggles ────────────
ENABLE_AI_MAINTENANCE=0
ENABLE_AI_DISCOVERY=0
# Headless Claude self-improvement loop. Keep OFF — the bot runs static.
ENABLE_SELF_IMPROVE_LOOP=0

# ──────────── Language ────────────
# en / fr / mixed. Replies always match parent tweet language regardless.
CONTENT_LANG_PRIMARY=en

# Twitter API tokens NOT REQUIRED — the bot uses browser automation only.
