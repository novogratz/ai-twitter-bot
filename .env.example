# ──────────── Identity ────────────
BOT_HANDLE=CryptoAIDecode

# ──────────── AI provider ────────────
# ollama / codex / opencode / claude / gemini. Default uses local Ollama only:
# with LLM_FALLBACK_CLI empty, a failed call fails. To opt into a cloud
# fallback, set LLM_FALLBACK_CLI=codex. An unknown provider name fails every
# call it routes, runs nothing, and is logged at start.
AI_CLI=ollama
LLM_FALLBACK_CLI=
NEWS_MODEL=opencode/big-pickle
REPLY_MODEL=opencode/big-pickle
PRIORITY_REPLY_MODEL=opencode/big-pickle
QUOTE_MODEL=opencode/big-pickle
ROAST_MODEL=opencode/big-pickle

# ──────────── Daily caps — reshare + engagement ────────────
MAX_REPLIES_PER_CYCLE=10
DIRECT_REPLY_MAX_PER_CYCLE=12
DIRECT_REPLY_MAX_EN_PER_CYCLE=1
DIRECT_REPLY_FEED_SCAN_LIMIT=90
DIRECT_REPLY_PROFILE_SCAN_LIMIT=30

# ──────────── Per-cycle quotas ────────────
LIKE_BOT_PER_CYCLE=22
LIKE_BOT_DAILY_CAP=1800
DIRECT_REPLY_MAX_AGE_MINUTES=1440
LIKE_TOP_TAB_PROBABILITY=0.55

# ──────────── Rate limits ────────────
LLM_MIN_SECONDS_BETWEEN_CALLS=75
LLM_MAX_CALLS_PER_HOUR=32

# ──────────── Self-modification toggles ────────────
# Read by operator_cycle.sh only: 1 lets it spend a Codex CLI run.
ENABLE_AI_MAINTENANCE=0

# ──────────── Language ────────────
# en / fr / mixed. Replies always match parent tweet language regardless.
CONTENT_LANG_PRIMARY=fr

# Twitter API tokens NOT REQUIRED — the bot uses browser automation only.

# Editorial policy: Toronto 04:30–23:30; six posts planned, at most eight, twenty minutes apart.
MAX_ORIGINALS_PER_DAY=8
MIN_SECONDS_BETWEEN_POSTS=1200
POST_JITTER_SECONDS=0
HUMAN_TYPO_HANDLES=

# Originals use the installed general model, with a strict output schema.
EDITORIAL_OLLAMA_MODEL=gemma4:31b
EDITORIAL_LLM_TIMEOUT_SECONDS=300
