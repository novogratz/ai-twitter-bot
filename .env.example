# @thesimaximalist, under docs/EDITORIAL_POLICY.md. Copy to .env; every key is
# described in docs/CONFIGURATION.md. .env is read once at start: restart the
# bot after any change. An unknown key or a badly typed value stops the start.
# Twitter API tokens are not needed: the bot drives Safari.

# ──────────── Account ────────────
# accounts/<BOT_ACCOUNT>/account.toml carries the handle and the language;
# BOT_HANDLE or CONTENT_LANG_PRIMARY set here would override it. Its network
# lists fill PROFILE_VISIT_ALLOWLIST, VIP_SCAN_HANDLES, PINNED_TRACKED_HANDLES
# and FR_FORCED_REPLY_HANDLES the same way. BOT_ACCOUNT=example runs the
# fictitious template Account, for a dry run only.
BOT_ACCOUNT=theaishrink
# Hourly news starts with main.py when enabled. Only enable Safari publication
# with operator authorization. This installation's operator enables both locally.
NEWS_ENABLED=0
NEWS_AUTO_PUBLISH=0
# NEWS_MIN_SECONDS_BETWEEN_POSTS=7200
# NEWS_CONFIG_FILE=
# Optional draft-only webhook; credentials stay in the environment.
# NEWS_WEBHOOK_URL=
# NEWS_WEBHOOK_TOKEN=
# Keep the folder name: it owns the existing state and Reply history.
# This Account's [limits] selects 30 scrolls / 240 posts per feed and no daytime
# breaks. Leave these unset to inherit its configuration; sleep is 00:00–04:30 Toronto.
# FEED_SCROLL_PASSES=30
# FEED_SWEEP_SCAN_LIMIT=240
# HOURLY_BREAK_MINUTES=0
# This Account inherits 16 searches: 4 major-author Latest, 8 Top, 4 first-hour
# Latest, plus 80 direct replies/cycle and 80 generations/feed. Configured major
# authors come first; 3+ observed likes, author variety and post views order each tier.
# DIRECT_REPLY_QUERIES_PER_CYCLE=24
# DIRECT_REPLY_PRIORITY_QUERIES_PER_CYCLE=4
# DIRECT_REPLY_LATEST_QUERIES_PER_CYCLE=6
# REPLY_PRIORITIZE_LARGE_ACCOUNTS=1
# DIRECT_REPLY_MAX_PER_CYCLE=80
# FEED_SWEEP_MAX_REPLIES_PER_CYCLE=80
# REPLY_PREFERRED_MIN_LIKES=3
# Optional YYYY-MM-DD Toronto date: double Reply discovery/generation budgets that day.
# REPLY_VOLUME_BOOST_DATE=

# ──────────── Safety ────────────
# DRY_RUN=1 logs every write instead of doing it.
DRY_RUN=0

# ──────────── Models ────────────
# Operator, 2026-11-01: Codex for every model route; Sol/xhigh for Replies.
# Codex must be installed and signed in. Fallbacks stay disabled.
AI_CLI=codex
PROFILE_LLM_PROVIDER=codex
REPLY_LLM_PROVIDER=codex
LLM_FALLBACK_CLI=
LLM_DISABLE_FALLBACK=1
REPLY_MODEL=gpt-6.1-sol
PRIORITY_REPLY_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=xhigh
# Originals: drafted and reviewed with a strict output schema.
EDITORIAL_LLM_TIMEOUT_SECONDS=300
# CLI models (codex, claude, gemini) of the primary CLI. Unset or blank, each
# call takes that CLI's default (MODEL_DEFAULTS). Ollama never reads them.
# NEWS_MODEL=
# CODEX_REASONING_EFFORT blank would keep the CLI's configured effort.

# ──────────── Bounded settings ────────────
# Commented out: each default is already the policy value. .env wins over an
# Account's [limits], so a line set here would undo what an Account tightens
# (accounts/example/ caps its Originals at 4 and its likes at 100).
# Originals: at most eight a day (ceiling), twenty minutes apart at least (floor).
# MAX_ORIGINALS_PER_DAY=8
# MIN_SECONDS_BETWEEN_POSTS=1200
# POST_JITTER_SECONDS=0
# Replies: uncapped per day, paced; debate turns capped per Engager per day.
# MIN_SECONDS_BETWEEN_REPLIES=8
# REPLY_JITTER_SECONDS=7
# DEBATE_MAX_TURNS_PER_AUTHOR_PER_DAY=4
# Likes.
# LIKE_BOT_PER_CYCLE=10
# LIKE_BOT_DAILY_CAP=500

# ──────────── Operator scripts ────────────
# Read by operator_cycle.sh only: 1 lets it spend a Codex CLI run.
ENABLE_AI_MAINTENANCE=0
ENABLE_CODEX_OPERATOR=0
### Licensed video feature: off and dry-run until explicitly activated.
VIDEO_ENABLED=0
VIDEO_LIVE=0
VIDEO_CONFIG_FILE=
VIDEO_CREDENTIALS_FILE=

# November 12: Reply capacity first; 3 likes preferred, no hard floor.
# REPLY_MIN_LIKES=0
# FEED_SWEEP_INTERVAL_MINUTES=8
# DIRECT_REPLY_CREATOR_QUERIES_PER_CYCLE=2
# PRIORITY_WATCH_INTERVAL_SECONDS=60
# PRIORITY_WATCH_NOTIFICATIONS=1
# SKIP_SLEEP_NIGHT_DATE=  # Explicit evening date, skips one following sleep window only.
# AWAKE_72H_START=  # Explicit ISO timestamp with timezone; one fixed 72-hour awake window.
# PRIORITY_QUOTE_DAILY_CAP=2
# PRIORITY_QUOTE_INTERVAL_MINUTES=240
# PRIORITY_REPOST_MIN_SECONDS=60
# MEME_REPOST_ENABLED=0  # Account opt-in; visually reviewed funny AI videos.
# MEME_REPOST_DAILY_CAP=20
# MEME_REPOST_MIN_LIKES=0
# MEME_REPOST_MIN_VIEWS=0
# MEME_REPOST_INTERVAL_MINUTES=30
