# @TheAIShrink, under docs/EDITORIAL_POLICY.md. Copy to .env; every key is
# described in docs/CONFIGURATION.md. .env is read once at start: restart the
# bot after any change. An unknown key or a badly typed value stops the start.
# Twitter API tokens are not needed: the bot drives Safari.

# ──────────── Account ────────────
# accounts/<BOT_ACCOUNT>/account.toml carries the handle and the language;
# BOT_HANDLE or CONTENT_LANG_PRIMARY set here would override it.
BOT_ACCOUNT=theaishrink

# ──────────── Safety ────────────
# DRY_RUN=1 logs every write instead of doing it.
DRY_RUN=0

# ──────────── Models ────────────
# Local Ollama only. With LLM_FALLBACK_CLI blank a failed call fails; set it
# to codex to let a failed call fall back to the cloud. An unknown provider
# name fails every call it routes, runs nothing, and is logged at start.
AI_CLI=ollama
PROFILE_LLM_PROVIDER=ollama
REPLY_LLM_PROVIDER=ollama
LLM_FALLBACK_CLI=
OLLAMA_BASE_URL=http://localhost:11434
# The Ollama model of the Replies; bin/run.sh pre-warms it.
OLLAMA_MODEL=qwen3.6:35b-a3b
# Originals: drafted and reviewed with a strict output schema.
EDITORIAL_OLLAMA_MODEL=gemma4:31b
EDITORIAL_LLM_TIMEOUT_SECONDS=300
# CLI models (codex, claude, gemini) of the primary CLI. Unset or blank, each
# call takes that CLI's default (MODEL_DEFAULTS). Ollama never reads them.
# NEWS_MODEL=
# REPLY_MODEL=
# PRIORITY_REPLY_MODEL=

# ──────────── Originals ────────────
# At most eight a day (ceiling), twenty minutes apart at least (floor).
MAX_ORIGINALS_PER_DAY=8
MIN_SECONDS_BETWEEN_POSTS=1200
POST_JITTER_SECONDS=0

# ──────────── Replies ────────────
# Uncapped per day, paced; debate turns capped per Engager per day.
MIN_SECONDS_BETWEEN_REPLIES=8
REPLY_JITTER_SECONDS=7
DEBATE_MAX_TURNS_PER_AUTHOR_PER_DAY=4

# ──────────── Likes ────────────
LIKE_BOT_PER_CYCLE=10
LIKE_BOT_DAILY_CAP=500

# ──────────── Operator scripts ────────────
# Read by operator_cycle.sh only: 1 lets it spend a Codex CLI run.
ENABLE_AI_MAINTENANCE=0
ENABLE_CODEX_OPERATOR=0
